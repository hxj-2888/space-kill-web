# 太空杀 · 网页版 (space-kill-web.pages.dev) 响应头
# 说明：
#   - 本文件会随 tools/deploy-pages.cjs 一起部署（白名单内）。
#   - 不设 X-Frame-Options / frame-ancestors：作品集等自有页面需要能引用本页；
#     CSP 收紧（script-src 'self' 等）另行评估：index.html 目前零内联脚本、
#     零内联事件处理器，具备收紧条件，但需连同联机 ws:// 的 connect-src 一起验证。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# 安卓安装包：强制附件下载，避免被浏览器当页面打开或落到 SPA 回退
# 〔2026-10-10〕「无法完整下载」根因修复：
#   1) Pages 免费版对静态资产**不支持 Range**（实测任何文件 -r 请求一律 200 全量、无 206），
#      4.5MB 一断就从头来；
#   2) 且 .apk **不在 Cloudflare 默认缓存扩展列表**（.zip 在！）→ CDN 永不缓存 → 更雪上加霜。
#   解法：实体文件改以 **SpaceKill.apk.zip** 分发（APK 本就是 ZIP，.zip 可被 CDN 缓存 →
#   缓存命中后 Range/断点续传可用），稳定 URL `/SpaceKill.apk` 由 _redirects 302 跳转过去，
#   Content-Disposition 把保存名定回 SpaceKill.apk。二维码 / README / Release 链接全部不用改。
/SpaceKill.apk
  Cache-Control: public, max-age=600
  Content-Disposition: attachment; filename="SpaceKill.apk"
  Accept-Ranges: bytes

# 实体（.zip 后缀才会进 CDN 缓存）；Content-Disposition 把保存名定回 SpaceKill.apk。
# max-age=600 而非 immutable：zip 文件名不随版本变，发新版后最多 10 分钟内边缘可能仍供旧包
#（发布低频，可接受；未来要彻底消除窗口，把 zip 改成带版本号文件名 + immutable + _redirects 同步生成）。
/SpaceKill.apk.zip
  Cache-Control: public, max-age=600
  Content-Disposition: attachment; filename="SpaceKill.apk"
  Content-Type: application/vnd.android.package-archive
  Accept-Ranges: bytes
